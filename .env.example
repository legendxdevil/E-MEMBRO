# Edge Memory Platform Configuration
APP_NAME=Edge Memory Platform
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Device Identity
DEVICE_ID=00000000-0000-0000-0000-000000000001
DEVICE_NAME=Edge Node Alpha (Device A)
DEVICE_TYPE=edge_device

# Storage & Databases
SQLITE_DB_PATH=data/edge_memory.db
EDGE_QDRANT_PATH=data/qdrant_edge
CLOUD_QDRANT_PATH=data/qdrant_cloud
CLOUD_QDRANT_URL=http://localhost:6333
USE_LOCAL_CLOUD_QDRANT=true

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384

# Selective Sync & Connectivity
SYNC_ENABLED=true
OFFLINE_SIMULATION=false
SYNC_INTERVAL_SECONDS=10
SYNC_BATCH_SIZE=20
MAX_SYNC_ATTEMPTS=5
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Rate Limiting
RATE_LIMIT_READ=60
RATE_LIMIT_WRITE=30
RATE_LIMIT_SYNC=10

# Security
API_SECRET_KEY=change_me_in_production_jwt_or_api_secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
